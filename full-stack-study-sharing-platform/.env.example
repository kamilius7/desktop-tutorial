# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Base64-encoded 32-byte secret key for AES-256-GCM message encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=wyKAMABXmL4GUtlq5jAX8fR/x47oMK0FplwEgX+386s=

# Optional Email Provider Configuration for OTP delivery:
# Primary: Resend API (recommended — free tier, delivers to Gmail)
# RESEND_API_KEY=re_your_api_key_here
# SMTP_FROM=StudyShare <noreply@yourdomain.com>
#
# Alternative: generic SMTP (used when RESEND_API_KEY is unset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=StudyShare <you@gmail.com>
#
# If nothing is configured, dev mode uses an Ethereal test account and only
# logs the preview URL (and the OTP code) to the server console.
