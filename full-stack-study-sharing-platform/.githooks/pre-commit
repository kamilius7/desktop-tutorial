#!/bin/sh
# Pre-commit secret guard. Enable with:
#   git config core.hooksPath .githooks
echo "Checking staged files for secrets..."

if git diff --cached --name-only | grep -Ei '(^|/)\.env($|\.)|\.env$|\.pem$|\.key$|\.crt$|postgres-data/|pgdata/|uploads/'; then
  echo "ERROR: Attempting to commit a file that must never be tracked (.env, key material, uploads, or local DB data)."
  echo "Remove it from the index:  git restore --staged <file>"
  exit 1
fi

# Flag hardcoded dev DB credentials in tracked source files.
if git diff --cached -U0 | grep -Ei 'postgresql://[A-Za-z0-9_]+:[^@]+@' ; then
  echo "ERROR: A database connection string with embedded credentials was found in the staged diff."
  exit 1
fi

exit 0
